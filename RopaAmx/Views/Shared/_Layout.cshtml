@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdmin = User.IsInRole(Roles.Administrador);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AMX K</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="barra">
        <nav class="menu">
            @if (autenticado)
            {
                <a asp-controller="Home" asp-action="Index">INICIO</a>
                <a asp-controller="Categoria" asp-action="Ver" asp-route-slug="hombre">HOMBRE</a>
                <a asp-controller="Categoria" asp-action="Ver" asp-route-slug="mujer">MUJER</a>
                <a asp-controller="Categoria" asp-action="Ver" asp-route-slug="ninos">NIÑOS</a>
                <a asp-controller="Productos" asp-action="Index">CATÁLOGO</a>
            }
            <a asp-controller="Home" asp-action="Contacto">CONTACTO</a>
        </nav>

        @if (autenticado)
        {
            <form class="buscador" asp-controller="Home" asp-action="Buscar" method="get">
                <input type="text" name="q" placeholder="BUSCAR" aria-label="Buscar productos" />
                <button type="submit" aria-label="Buscar">&#128269;</button>
            </form>
        }

        <div class="sesion">
            @if (autenticado)
            {
                <span class="usuario">@User.Identity?.Name <small class="insignia">@(esAdmin ? "Administrador" : "Lector")</small></span>
                @if (esAdmin)
                {
                    <a asp-controller="Cuenta" asp-action="Usuarios">USUARIOS</a>
                }
                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                    <button type="submit" class="btn-salir">Salir</button>
                </form>
            }
            else
            {
                <a asp-controller="Cuenta" asp-action="Login">INICIAR SESIÓN</a>
                <a asp-controller="Cuenta" asp-action="Registro">CREAR CUENTA</a>
            }
        </div>
    </header>

    @if (TempData["Ok"] is string mensajeOk)
    {
        <div class="alerta ok" role="status">@mensajeOk</div>
    }
    @if (TempData["Error"] is string mensajeError)
    {
        <div class="alerta mal" role="alert">@mensajeError</div>
    }

    @RenderBody()

    <footer class="pie">
        <div class="pie-columnas">
            <div>
                <h4>CONTÁCTANOS AL:</h4>
                <p>961 000 0000</p>
            </div>
            <div>
                <h4>SÍGUENOS EN</h4>
                <p class="redes">
                    <a href="#">Facebook</a>
                    <a href="#">Instagram</a>
                    <a href="#">YouTube</a>
                </p>
            </div>
        </div>
        <p class="creditos">ELABORADO POR KAROL ALBERTO GALDÁMEZ GÓMEZ | LSC 2026</p>
    </footer>
</body>
</html>
